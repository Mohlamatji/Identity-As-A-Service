 * ============================================================================
 */

putenv('VERIFICATION_PROVIDER=verifynow');
putenv('VERIFYNOW_API_KEY=REPLACE_WITH_YOUR_REAL_KEY_IN_local.php_NOT_HERE');
// sandbox = 0 credits, safe to test with any valid-format ID number.
// production = real credits spent, per VerifyNow's real pricing.
putenv('VERIFYNOW_MODE=sandbox');

