# Copy to .env and load with your preferred method (e.g. `export $(cat .env | xargs)`
# before starting the PHP server), or set these as real environment variables.
#
# Using Apache/XAMPP instead of `php -S`? Use config/local.php.example
# instead - Apache doesn't inherit your shell's environment the way a
# terminal does, so this file won't reach it.

DB_DRIVER=sqlite
# --- MySQL settings, only used when DB_DRIVER=mysql ---
DB_HOST=sql303.byethost5.com
DB_NAME=b5_43371560_identityvault
DB_USER=b5_43371560
DB_PASS=VHS5j4816*97

# REQUIRED in production, 32+ random chars:  php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=change-me-to-a-random-32-byte-value

# development (default: zero-setup demo) | production (fail-closed, see README)
APP_ENV=development
# Demo console + PayPal checkout page + fraud-simulation toggles. Defaults to on in development, off in production.
DEMO_MODE=
# Dev only. Lets the browser SDK fall back to a clearly-labelled simulated liveness when there is no camera.
ALLOW_SIMULATED_LIVENESS=

# Auth. Prefer per-client keys:  php bin/create-api-client.php --name="Demo Bank" --scopes=verify,consent,transactions
# API_KEY is the legacy single shared secret (full scope).
API_KEY=
# Prefer a hash:  php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Behind a CDN/proxy? Trust its forwarded IP + country header (e.g. Cloudflare's CF-IPCountry).
TRUST_PROXY_HEADERS=0

# --- PayPal (hackathon integration). mock needs no credentials. ---
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_ZAR_PER_USD=18.5

# --- AI Risk Analyst (optional; falls back to a deterministic template) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Signed outbound decision webhooks (optional) ---
WEBHOOK_URL=
WEBHOOK_SECRET=

# mock | datanamix | verifynow
VERIFICATION_PROVIDER=mock

DATANAMIX_BASE_URL=https://api.datanamix.com
DATANAMIX_API_KEY=

VERIFYNOW_BASE_URL=https://www.verifynow.co.za/api/external
VERIFYNOW_API_KEY=
# sandbox = 0 credits, safe to test with any valid-format ID number.
# production = real credits spent, per VerifyNow's confirmed pricing.
VERIFYNOW_MODE=sandbox
