# Copy to .env and load with your preferred method (e.g. `export $(cat .env | xargs)`
# before starting the PHP server), or set these as real environment variables.
#
# Using Apache/XAMPP instead of `php -S`? Use config/local.php.example
# instead - Apache doesn't inherit your shell's environment the way a
# terminal does, so this file won't reach it.

DB_DRIVER=sqlite
# --- MySQL settings, only used when DB_DRIVER=mysql ---
DB_HOST=127.0.0.1
DB_NAME=identity_vault
DB_USER=root
DB_PASS=

APP_ENCRYPTION_KEY=change-me-to-a-random-32-byte-value

# Both opt-in - leave blank for local/dev (no auth enforced). Set both
# before deploying anywhere public.
API_KEY=
ADMIN_PASSWORD=

# mock | datanamix | verifynow
VERIFICATION_PROVIDER=mock

DATANAMIX_BASE_URL=https://api.datanamix.com
DATANAMIX_API_KEY=

VERIFYNOW_BASE_URL=https://www.verifynow.co.za/api/external
VERIFYNOW_API_KEY=
# sandbox = 0 credits, safe to test with any valid-format ID number.
# production = real credits spent, per VerifyNow's confirmed pricing.
VERIFYNOW_MODE=sandbox
